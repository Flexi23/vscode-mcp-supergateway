{
  "upstreams": [
    {
      "id": "codebase-memory",
      "namespace": "codebasememory",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"]
    },
    {
      "id": "siyuan-note",
      "namespace": "siyuannote",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "siyuan-mcp@latest"],
      "env": {
        "SIYUAN_HOST": "siyuan",
        "SIYUAN_PORT": "6806"
      }
    },
    {
      "id": "gitlab",
      "namespace": "gitlab",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_API_URL": "https://gitlab.uni-rostock.de/api/v4"
      }
    },
    {
      "id": "markitdown",
      "namespace": "markitdown",
      "transport": "stdio",
      "command": "markitdown-mcp",
      "args": []
    }
  ]
}
