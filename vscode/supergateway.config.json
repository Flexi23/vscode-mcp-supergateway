{
  "adminDbPath": "C:\\gitlab.uni-rostock.de\\limati-inf\\.vscode\\data\\gateway.db",
  "upstreams": [
    {
      "id": "codebase-memory",
      "namespace": "codebasememory",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "codebase-memory-mcp"
      ],
      "config": {
        "auto_index": false,
        "auto_index_limit": 50000,
        "auto_watch": true,
        "ui-lang": "auto"
      },
      "ui": {
        "enabled": true,
        "port": 9749,
        "toolProfile": "analysis"
      }
    },
    {
      "id": "markdown-vault",
      "namespace": "markdownvault",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "@wirux/mcp-markdown-vault"
      ],
      "env": {
        "VAULT_PATH": "C:\\gitlab.uni-rostock.de\\limati-inf\\vscode-mcp-supergateway\\vault"
      }
    },
    {
      "id": "gitlab",
      "namespace": "gitlab",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_API_URL": "https://gitlab.uni-rostock.de/api/v4"
      }
    }
  ]
}