# Copy to .env and adjust. On Docker Desktop (Windows/macOS), host.docker.internal
# resolves to the host machine, so a host-side LM Studio instance stays reachable.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# GitLab PAT for the gitlab upstream inside the `gateway` service (see docker-compose.yml).
GITLAB_PERSONAL_ACCESS_TOKEN=
