# Copy to .env and adjust. All port numbers are defined here and referenced from
# docker-compose.yml as ${VAR}; no numeric port literals are allowed anywhere else.
MCP_GATEWAY_PUBLIC_PORT=8080
MCP_GATEWAY_ADMIN_PORT=3110
ADMIN_UI_PORT=3100
BACKEND_PORT=8081
CBM_UI_PORT=9749
CBM_UI_BACKEND_PORT=9750
SIYUAN_PORT=6806

# On Docker Desktop (Windows/macOS), host.docker.internal resolves to the host
# machine, so a host-side LM Studio instance stays reachable.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Absolute host path used as the bind mount for the gateway's runtime data store
# (gateway.db + admin-gateway-config.json). Inside the container, it remains /app/data.
GATEWAY_HOST_DATA_DIR=/absolute/path/to/gateway-data

# GitLab API endpoint and PAT for the `gitlab` upstream inside the `gateway` service.
GITLAB_API_URL=https://gitlab.uni-rostock.de/api/v4
GITLAB_PERSONAL_ACCESS_TOKEN=

# SiYuan Note (see docker-compose.yml `siyuan` service). For local/dev installs,
# the SiYuan kernel can run without a token. Leave SIYUAN_TOKEN empty and set
# SIYUAN_TOKEN_REQUIRED=false to disable auth entirely. In Docker mode, the
# kernel requires either a lock-screen code or an explicit bypass.
# If you do want an API token, set it here and set SIYUAN_TOKEN_REQUIRED=true.
SIYUAN_TOKEN=
SIYUAN_TOKEN_REQUIRED=false
SIYUAN_ACCESS_AUTH_CODE=
SIYUAN_ACCESS_AUTH_CODE_BYPASS=true

# Enable startup auto-indexing for Codebase Memory when you want it to index a
# repository automatically on container startup.
CBM_AUTO_INDEX_ENABLED=false

# Optional when CBM_AUTO_INDEX_ENABLED is false; required only for the startup
# auto-index path when the flag is set to true.
CBM_AUTO_INDEX_PATH=/absolute/path/to/workspace-root

# Absolute host path that Codebase Memory opens by default in its UI.
CBM_DEFAULT_PATH=/absolute/path/to/workspace-root

# Absolute host path used as the bind mount for Codebase Memory's writable cache.
# The directory is mounted into the gateway container at /root/cbm-cache.
CBM_CACHE_DIR=/absolute/path/to/cbm-cache

# Absolute path to the SiYuan workspace on the host (notebooks/docs/assets).
# This is mounted directly into the SiYuan container as /siyuan/workspace.
SIYUAN_WORKSPACE_DIR=/absolute/path/to/siyuan-workspace
